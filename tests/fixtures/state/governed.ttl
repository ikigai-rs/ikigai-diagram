@prefix ik: <https://ikigai-rs.dev/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ikigai:chain:root> a ik:Chain ;
    ik:severed false ;
    ik:layers <urn:ikigai:chain:root:layer:1> .
<urn:ikigai:chain:root:layer:1> rdf:first <urn:ikigai:space:_:1> ;
    rdf:rest rdf:nil .

<urn:ikigai:space:_:1> a ik:Fallback ;
    ik:layers <urn:ikigai:space:_:1:layer:1> .
<urn:ikigai:space:_:1:layer:1> rdf:first <urn:ikigai:space:_:2> ;
    rdf:rest <urn:ikigai:space:_:1:layer:2> .
<urn:ikigai:space:_:1:layer:2> rdf:first <urn:iki:space:demo-limit> ;
    rdf:rest <urn:ikigai:space:_:1:layer:3> .
<urn:ikigai:space:_:1:layer:3> rdf:first <urn:iki:space:demo-breaker> ;
    rdf:rest <urn:ikigai:space:_:1:layer:4> .
<urn:ikigai:space:_:1:layer:4> rdf:first <urn:iki:space:demo-pool> ;
    rdf:rest <urn:ikigai:space:_:1:layer:5> .
<urn:ikigai:space:_:1:layer:5> rdf:first <urn:ikigai:space:_:3> ;
    rdf:rest <urn:ikigai:space:_:1:layer:6> .
<urn:ikigai:space:_:1:layer:6> rdf:first <urn:ikigai:space:_:4> ;
    rdf:rest rdf:nil .

<urn:ikigai:space:_:2> a ik:EndpointSpace ;
    ik:pattern "urn:throttle:state" ;
    ik:pattern "urn:throttle:state:{member}" ;
    ik:doors <urn:ikigai:space:_:2:doors:1> .
<urn:ikigai:space:_:2:doors:1> rdf:first <urn:ikigai:space:_:2:door:1> ;
    rdf:rest <urn:ikigai:space:_:2:doors:2> .
<urn:ikigai:space:_:2:doors:2> rdf:first <urn:ikigai:space:_:2:door:2> ;
    rdf:rest rdf:nil .

<urn:ikigai:space:_:2:door:1> a ik:Door ;
    ik:pattern "urn:throttle:state" ;
    ik:matchKind "exact" ;
    ik:endpointName "throttle-state" .

<urn:ikigai:space:_:2:door:2> a ik:Door ;
    ik:pattern "urn:throttle:state:{member}" ;
    ik:matchKind "template" ;
    ik:endpointName "throttle-state-member" .

<urn:iki:space:demo-limit> a ik:EndpointSpace ;
    ik:pattern "urn:demo:limit:ok" ;
    ik:pattern "urn:demo:limit:down" ;
    ik:doors <urn:iki:space:demo-limit:doors:1> .
<urn:iki:space:demo-limit:doors:1> rdf:first <urn:iki:space:demo-limit:door:1> ;
    rdf:rest <urn:iki:space:demo-limit:doors:2> .
<urn:iki:space:demo-limit:doors:2> rdf:first <urn:iki:space:demo-limit:door:2> ;
    rdf:rest rdf:nil .

<urn:iki:space:demo-limit:door:1> a ik:Door ;
    ik:pattern "urn:demo:limit:ok" ;
    ik:matchKind "exact" ;
    ik:endpointName "ok" .

<urn:iki:space:demo-limit:door:2> a ik:Door ;
    ik:pattern "urn:demo:limit:down" ;
    ik:matchKind "exact" ;
    ik:endpointName "down" .

<urn:iki:space:demo-breaker> a ik:EndpointSpace ;
    ik:pattern "urn:demo:breaker:ok" ;
    ik:pattern "urn:demo:breaker:down" ;
    ik:doors <urn:iki:space:demo-breaker:doors:1> .
<urn:iki:space:demo-breaker:doors:1> rdf:first <urn:iki:space:demo-breaker:door:1> ;
    rdf:rest <urn:iki:space:demo-breaker:doors:2> .
<urn:iki:space:demo-breaker:doors:2> rdf:first <urn:iki:space:demo-breaker:door:2> ;
    rdf:rest rdf:nil .

<urn:iki:space:demo-breaker:door:1> a ik:Door ;
    ik:pattern "urn:demo:breaker:ok" ;
    ik:matchKind "exact" ;
    ik:endpointName "ok" .

<urn:iki:space:demo-breaker:door:2> a ik:Door ;
    ik:pattern "urn:demo:breaker:down" ;
    ik:matchKind "exact" ;
    ik:endpointName "down" .

<urn:iki:space:demo-pool> a ik:EndpointSpace ;
    ik:pattern "urn:demo:pool:ok" ;
    ik:pattern "urn:demo:pool:down" ;
    ik:doors <urn:iki:space:demo-pool:doors:1> .
<urn:iki:space:demo-pool:doors:1> rdf:first <urn:iki:space:demo-pool:door:1> ;
    rdf:rest <urn:iki:space:demo-pool:doors:2> .
<urn:iki:space:demo-pool:doors:2> rdf:first <urn:iki:space:demo-pool:door:2> ;
    rdf:rest rdf:nil .

<urn:iki:space:demo-pool:door:1> a ik:Door ;
    ik:pattern "urn:demo:pool:ok" ;
    ik:matchKind "exact" ;
    ik:endpointName "ok" .

<urn:iki:space:demo-pool:door:2> a ik:Door ;
    ik:pattern "urn:demo:pool:down" ;
    ik:matchKind "exact" ;
    ik:endpointName "down" .

<urn:ikigai:space:_:3> a ik:OpaqueSpace .

<urn:ikigai:space:_:4> a ik:Mount ;
    ik:prefix "urn:standby:" ;
    ik:space <urn:iki:space:demo-backup> .

<urn:iki:space:demo-backup> a ik:EndpointSpace ;
    ik:pattern "urn:demo:dr:x" ;
    ik:doors <urn:iki:space:demo-backup:doors:1> .
<urn:iki:space:demo-backup:doors:1> rdf:first <urn:iki:space:demo-backup:door:1> ;
    rdf:rest rdf:nil .

<urn:iki:space:demo-backup:door:1> a ik:Door ;
    ik:pattern "urn:demo:dr:x" ;
    ik:matchKind "exact" ;
    ik:endpointName "backup" .
